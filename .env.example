# qltb-web — copy sang .env.local
# cp .env.example .env.local
#
# LƯU Ý: biến NEXT_PUBLIC_* bị nhúng vào bundle LÚC BUILD, không đọc được lúc
# chạy. Trên Vercel phải khai trong Project Settings → Environment Variables
# TRƯỚC lần build production, rồi Redeploy nếu đổi giá trị.
#
# Local:
NEXT_PUBLIC_API_BASE_URL=http://localhost:3400/api/v1
NEXT_PUBLIC_APP_NAME=QLTB
#
# Vercel (Production) — phải https, không được http (Mixed Content):
# NEXT_PUBLIC_API_BASE_URL=https://<qltb-service>.vercel.app/api/v1
